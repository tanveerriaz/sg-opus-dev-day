# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for the ordering agent (#2). Server-only.
ANTHROPIC_API_KEY=
# Optional: Claude model for the agent (default claude-opus-5-5)
CLAUDE_MODEL=

# OpenAI API key for realtime voice (#6); still planned for the scraper (#3). Server-only:
# the phone only ever gets a short-lived key made from it.
OPENAI_API_KEY=
# Optional: realtime model and voice (defaults gpt-realtime-2.1 and marin)
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
