# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Optional: model for menu extraction (needs image input + structured outputs). Defaults to gpt-4.1.
OPENAI_EXTRACT_MODEL=

# Optional: Jina Reader key for higher rate limits (https://jina.ai/reader). Works without one.
JINA_API_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
